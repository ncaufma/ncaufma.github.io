---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectCard from '../../../components/ui/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { supportedLanguages, isLanguage, publicSlug, byLang, ui } from '../../../i18n';

export async function getStaticPaths() {
  const areas = await getCollection('research-areas');
  return supportedLanguages.flatMap(lang =>
    byLang(areas, lang).map(area => ({
      params: { lang, slug: publicSlug(area.slug) },
      props: { area },
    })),
  );
}

const lang = isLanguage(Astro.params.lang) ? Astro.params.lang : 'en';
const { area } = Astro.props;
const copy = ui[lang].researchAreas;
const typeLabels: Record<string, string> = ui[lang].publications.types;
const { Content } = await area.render();
const areaSlug = publicSlug(area.slug);
const areaProjects = byLang(await getCollection('projects'), lang)
  .filter(project => project.data.researchArea === areaSlug);
const areaPublications = byLang(await getCollection('publications'), 'en')
  .filter(pub => pub.data.researchArea === areaSlug)
  .sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));
---

<BaseLayout lang={lang} title={area.data.title} description={area.data.summary}>
  <div class="page-hero" style={`--area-color: ${area.data.color ?? 'var(--color-primary)'}`}>
    <div class="container">
      <a href={`/${lang}/research-areas/`} class="back-link">{copy.back}</a>
      <h1 class="display-lg">{area.data.title}</h1>
      {area.data.summary && <p class="page-lead">{area.data.summary}</p>}
    </div>
  </div>
  <div class="container area-body">
    {Content && (
      <div class="area-content prose">
        <Content />
      </div>
    )}
    {areaProjects.length > 0 && (
      <section class="area-projects-section">
        <div class="section-heading-row">
          <div>
            <span class="section-label">{copy.appliedWork}</span>
            <h2>{copy.projectsInArea}</h2>
          </div>
          <span class="section-count">{areaProjects.length}</span>
        </div>
        <div class="projects-grid">
          {areaProjects.map((project, index) => (
            <ProjectCard
              title={project.data.title}
              partner={project.data.partner}
              status={project.data.status}
              description={project.data.description}
              highlights={project.data.highlights}
              slug={publicSlug(project.slug)}
              lang={lang}
              featured={project.data.featured}
              index={index}
            />
          ))}
        </div>
      </section>
    )}
    {areaPublications.length > 0 && (
      <section class="area-publications-section">
        <div class="section-heading-row">
          <div>
            <span class="section-label">{copy.scientificOutput}</span>
            <h2>{copy.selectedPublications}</h2>
          </div>
          <span class="section-count">{areaPublications.length}</span>
        </div>
        <ul class="publications-list">
          {areaPublications.slice(0, 8).map(publication => (
            <li class="publication-item">
              <div class="publication-meta">
                {publication.data.year && <span class="publication-year">{publication.data.year}</span>}
                <span class="tag tag-neutral">{typeLabels[publication.data.type] ?? publication.data.type}</span>
              </div>
              <div class="publication-content">
                {publication.data.doi ? (
                  <a href={`https://doi.org/${publication.data.doi}`} target="_blank" rel="noopener noreferrer">
                    {publication.data.title}
                  </a>
                ) : publication.data.url ? (
                  <a href={publication.data.url} target="_blank" rel="noopener noreferrer">
                    {publication.data.title}
                  </a>
                ) : (
                  <span>{publication.data.title}</span>
                )}
                {publication.data.venue && <p>{publication.data.venue}</p>}
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>

<style>
.page-hero {
  background: var(--color-bg-alt);
  padding-block: var(--space-8) var(--space-10);
  border-bottom: 4px solid var(--area-color, var(--color-primary));
}
.back-link {
  display: inline-block;
  margin-bottom: var(--space-4);
  color: var(--color-text-muted);
  font-size: 0.875rem;
  font-weight: 600;
  transition: color var(--transition-fast);
}
.back-link:hover { color: var(--color-primary); }
.page-lead {
  max-width: 60ch;
  margin-top: var(--space-4);
  color: var(--color-text-muted);
  font-size: 1.125rem;
  line-height: 1.7;
}
.area-body {
  max-width: 820px;
  margin-inline: auto;
  padding-block: var(--space-10);
}
.area-content { min-width: 0; }
.area-projects-section,
.area-publications-section { margin-top: var(--space-12); }
.section-heading-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--space-4);
  margin-bottom: var(--space-6);
  padding-bottom: var(--space-3);
  border-bottom: 1.5px solid var(--color-border);
}
.section-heading-row h2 {
  font-size: 1.5rem;
  letter-spacing: -0.02em;
}
.section-label {
  display: block;
  margin-bottom: var(--space-1);
  color: var(--color-primary);
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}
.section-count {
  min-width: 38px;
  height: 38px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: var(--radius-full);
  background: var(--color-bg-alt);
  color: var(--color-text-muted);
  font-size: 0.875rem;
  font-weight: 800;
}
.projects-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-5);
}
.publications-list {
  list-style: none;
  border-top: 1.5px solid var(--color-border);
}
.publication-item {
  display: grid;
  grid-template-columns: 130px 1fr;
  gap: var(--space-5);
  padding: var(--space-5) 0;
  border-bottom: 1.5px solid var(--color-border);
}
.publication-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--space-2);
}
.publication-year {
  color: var(--color-text-muted);
  font-size: 0.875rem;
  font-weight: 800;
}
.publication-content {
  min-width: 0;
  color: var(--color-text);
  font-weight: 700;
  line-height: 1.45;
}
.publication-content a {
  color: var(--color-primary);
  transition: color var(--transition-fast);
}
.publication-content a:hover { color: var(--color-primary-dark); }
.publication-content p {
  margin-top: var(--space-1);
  color: var(--color-text-muted);
  font-size: 0.875rem;
  font-weight: 400;
  font-style: italic;
}
@media (max-width: 900px) {
  .projects-grid { grid-template-columns: minmax(0, 1fr); }
  .publication-item { grid-template-columns: 1fr; gap: var(--space-2); }
  .publication-meta { flex-direction: row; align-items: center; }
}
</style>
