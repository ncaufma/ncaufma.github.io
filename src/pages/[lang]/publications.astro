---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { supportedLanguages, isLanguage, byLang, ui } from '../../i18n';

export function getStaticPaths() {
  return supportedLanguages.map(lang => ({ params: { lang } }));
}

const lang = isLanguage(Astro.params.lang) ? Astro.params.lang : 'en';
const copy = ui[lang].publications;
const typeLabels: Record<string, string> = copy.types;
const pubs = byLang(await getCollection('publications'), 'en');
const sorted = pubs.sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));
const years = [...new Set(sorted.map(pub => pub.data.year).filter(Boolean))]
  .sort((a, b) => (b as number) - (a as number));
const types = [...new Set(sorted.map(pub => pub.data.type).filter(Boolean))];
---

<BaseLayout lang={lang} title={copy.pageTitle} description={copy.description}>
  <div class="page-hero">
    <div class="container">
      <h1 class="display-lg">{copy.pageTitle}</h1>
      <p class="page-lead">{copy.lead.replace('{count}', String(pubs.length))}</p>
    </div>
  </div>
  <section class="section">
    <div class="container">
      <div class="pub-filters">
        <div class="filter-group">
          <label class="filter-label" for="year-filter">{copy.year}</label>
          <select id="year-filter" class="form-input" style="width:auto">
            <option value="all">{copy.allYears}</option>
            {years.map(year => <option value={String(year)}>{year}</option>)}
          </select>
        </div>
        <div class="filter-group">
          <label class="filter-label" for="type-filter">{copy.type}</label>
          <select id="type-filter" class="form-input" style="width:auto">
            <option value="all">{copy.allTypes}</option>
            {types.map(type => <option value={type}>{typeLabels[type] ?? type}</option>)}
          </select>
        </div>
      </div>
      {sorted.length > 0 ? (
        <ul class="pub-list" id="pub-list">
          {sorted.map(pub => (
            <li class="pub-item" data-year={String(pub.data.year ?? '')} data-type={pub.data.type}>
              <div class="pub-type-badge">
                <span class="tag tag-primary">{typeLabels[pub.data.type] ?? pub.data.type}</span>
                {pub.data.year && <span class="pub-year">{pub.data.year}</span>}
              </div>
              <div class="pub-content">
                <h3 class="pub-title">
                  {pub.data.doi ? (
                    <a href={`https://doi.org/${pub.data.doi}`} target="_blank" rel="noopener noreferrer">{pub.data.title}</a>
                  ) : pub.data.url ? (
                    <a href={pub.data.url} target="_blank" rel="noopener noreferrer">{pub.data.title}</a>
                  ) : pub.data.title}
                </h3>
                {pub.data.authors.length > 0 && <p class="pub-authors">{pub.data.authors.join('; ')}</p>}
                {pub.data.venue && <p class="pub-venue">{pub.data.venue}</p>}
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <p class="pub-empty">{copy.empty}</p>
      )}
      <p id="pub-no-results" class="pub-empty" style="display:none" aria-live="polite">
        {copy.noResults}
      </p>
    </div>
  </section>
  <script>
    const yearSel = document.getElementById('year-filter');
    const typeSel = document.getElementById('type-filter');
    const items = document.querySelectorAll<HTMLElement>('#pub-list .pub-item');
    const noResult = document.getElementById('pub-no-results');
    function applyFilters() {
      let visible = 0;
      items.forEach(item => {
        const year = yearSel instanceof HTMLSelectElement ? yearSel.value : 'all';
        const type = typeSel instanceof HTMLSelectElement ? typeSel.value : 'all';
        const show = (year === 'all' || item.dataset.year === year) && (type === 'all' || item.dataset.type === type);
        item.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      if (noResult) noResult.style.display = visible === 0 ? '' : 'none';
    }
    yearSel?.addEventListener('change', applyFilters);
    typeSel?.addEventListener('change', applyFilters);
  </script>
</BaseLayout>

<style>
.page-hero { padding-block: var(--space-8) var(--space-10); background: var(--color-bg-alt); }
.page-lead { font-size: 1.125rem; color: var(--color-text-muted); max-width: 52ch; margin-top: var(--space-4); }
.pub-filters { display:flex; gap:var(--space-4); align-items:flex-end; flex-wrap:wrap; margin-bottom:var(--space-8); }
.filter-group { display:flex; flex-direction:column; gap:var(--space-1); }
.filter-label { font-size:.75rem; font-weight:700; text-transform:uppercase; color:var(--color-text-muted); }
.pub-list { list-style:none; display:flex; flex-direction:column; margin:0; padding:0; }
.pub-item { display:grid; grid-template-columns:160px 1fr; gap:var(--space-6); padding:var(--space-5) 0; border-bottom:1.5px solid var(--color-border); }
.pub-type-badge { display:flex; flex-direction:column; gap:var(--space-2); }
.pub-year { font-size:.875rem; font-weight:700; color:var(--color-text-muted); }
.pub-title { font-size:1rem; }
.pub-title a { color:var(--color-primary); text-decoration:none; }
.pub-authors,.pub-venue { font-size:.875rem; color:var(--color-text-muted); }
.pub-empty { padding:var(--space-16); text-align:center; color:var(--color-text-muted); }
@media (max-width: 900px) { .pub-item { grid-template-columns: 1fr; gap: var(--space-2); } }
</style>
