---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import { supportedLanguages, isLanguage, ui } from '../../i18n';

export function getStaticPaths() {
  return supportedLanguages.map(lang => ({ params: { lang } }));
}

const lang = isLanguage(Astro.params.lang) ? Astro.params.lang : 'en';
const copy = ui[lang].about;
const page = await getEntry('pages', `${lang}/about`);
const settings = await getEntry('settings', `${lang}/site`);
if (!page) throw new Error(`Missing pages/${lang}/about`);
const { Content } = await page.render();
const mapsEmbed = settings?.data.googleMapsEmbed ?? '';
const hasMap = Boolean(mapsEmbed && !mapsEmbed.startsWith('[REQUIRED'));
const rawAddress = settings?.data.address ?? '';
const addressLines = rawAddress && !rawAddress.startsWith('[REQUIRED')
  ? rawAddress.split(/\r?\n/).filter(Boolean)
  : copy.address;
const mapEmbedUrl = 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3985.8401600675516!2d-44.31009212673561!3d-2.5588115383374785!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x7f68f5cf9040faf%3A0xfcfade37aaad117d!2sN%C3%BAcleo%20de%20computa%C3%A7%C3%A3o%20Aplicada%20UFMA!5e0!3m2!1sen!2sbr!4v1776634692233!5m2!1sen!2sbr';
---

<BaseLayout lang={lang} title={page.data.title} description={page.data.description}>
  <div class="page-hero about-hero">
    <div class="container">
      <span class="hero-kicker">{page.data.title}</span>
      <h1 class="display-lg">{copy.headline}</h1>
      <p class="hero-lead">{page.data.description || copy.leadFallback}</p>
      <div class="about-nav" aria-label={copy.navAria}>
        <a href="#history">{copy.nav.history}</a>
        <a href="#mission">{copy.nav.mission}</a>
        <a href="#infrastructure">{copy.nav.infrastructure}</a>
        <a href="#affiliation">{copy.nav.affiliation}</a>
        <a href="#location">{copy.nav.location}</a>
      </div>
    </div>
  </div>

  <section class="about-section" id="history">
    <div class="container about-narrow">
      <span class="section-kicker">{copy.historyKicker}</span>
      <h2>{copy.historyTitle}</h2>
      <div class="timeline">
        {copy.timeline.map(item => (
          <article class="timeline-item">
            <span class="timeline-year">{item.year}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))}
      </div>
      <div class="prose about-story">
        <Content />
      </div>
    </div>
  </section>

  <section class="about-section mission-section" id="mission">
    <div class="container">
      <span class="section-kicker">{copy.missionKicker}</span>
      <h2>{copy.missionTitle}</h2>
      <div class="mission-grid">
        {copy.mission.map((item, index) => (
          <article class="mission-card">
            <span class="mission-number">{String(index + 1).padStart(2, '0')}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="about-section" id="infrastructure">
    <div class="container">
      <span class="section-kicker">{copy.infraKicker}</span>
      <h2>{copy.infraTitle}</h2>
      <div class="infrastructure-grid">
        <article class="infra-card infra-featured">
          <span class="infra-number">{copy.infraFeaturedStat}</span>
          <h3>{copy.infraFeaturedTitle}</h3>
          <p>{copy.infraFeaturedText}</p>
        </article>
        <article class="infra-card">
          <span class="infra-label">{copy.infraGpuLabel}</span>
          <h3>{copy.infraGpuTitle}</h3>
          <p>{copy.infraGpuText}</p>
        </article>
        <article class="infra-card">
          <span class="infra-label">{copy.infraMemoryLabel}</span>
          <h3>{copy.infraMemoryTitle}</h3>
          <p>{copy.infraMemoryText}</p>
        </article>
        <article class="infra-card">
          <span class="infra-label">{copy.infraCapacityLabel}</span>
          <h3>{copy.infraCapacityTitle}</h3>
          <p>{copy.infraCapacityText}</p>
        </article>
      </div>
    </div>
  </section>

  <section class="about-section affiliation-section" id="affiliation">
    <div class="container">
      <span class="section-kicker">{copy.affiliationKicker}</span>
      <h2>{copy.affiliationTitle}</h2>
      <p class="affiliation-lead">{copy.affiliationLead}</p>
      <div class="affiliation-grid">
        {copy.programs.map(program => (
          <article class="affiliation-card">
            <span>{program.code}</span>
            <h3>{program.title}</h3>
            <p>{program.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="about-section location-section" id="location">
    <div class="container">
      <div class="location-grid">
        <div class="location-info">
          <span class="section-kicker">{copy.locationKicker}</span>
          <h2>{copy.locationTitle}</h2>
          <address>
            {addressLines.map((line, index) => (
              index === 0 ? <strong>{line}</strong> : <span>{line}</span>
            ))}
          </address>
          <a href="https://www.google.com/maps/place/N%C3%BAcleo+de+computa%C3%A7%C3%A3o+Aplicada+UFMA/" target="_blank" rel="noopener noreferrer" class="btn btn-outline">
            {copy.openMaps}
          </a>
        </div>
        <div class="map-block">
          <iframe
            src={hasMap ? mapsEmbed : mapEmbedUrl}
            width="100%"
            height="420"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title={copy.mapTitle}
          ></iframe>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.about-hero {
  padding-block: var(--space-16);
  background:
    linear-gradient(135deg, rgba(35,70,229,0.05), transparent 55%),
    var(--color-bg-alt);
}
.hero-kicker,
.section-kicker {
  display: block;
  color: var(--color-primary);
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}
.hero-kicker { margin-bottom: var(--space-4); }
.about-hero .display-lg {
  max-width: 12ch;
  margin-bottom: var(--space-5);
  font-size: clamp(2.5rem, 6vw, 5rem);
  letter-spacing: -0.055em;
}
.hero-lead {
  max-width: 680px;
  color: var(--color-text-muted);
  font-size: 1.125rem;
  line-height: 1.7;
}
.about-nav {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-top: var(--space-8);
}
.about-nav a {
  padding: 0.4rem 0.75rem;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-full);
  background: rgba(255,255,255,0.75);
  color: var(--color-text-muted);
  font-size: 0.8125rem;
  font-weight: 700;
  transition: all var(--transition-fast);
}
.about-nav a:hover {
  border-color: var(--color-primary);
  color: var(--color-primary);
  background: #fff;
}
.about-section {
  padding-block: var(--space-16);
  scroll-margin-top: 84px;
}
.about-section h2 {
  margin-bottom: var(--space-8);
  font-size: clamp(1.75rem, 3.5vw, 2.75rem);
  letter-spacing: -0.04em;
}
.about-narrow {
  max-width: 820px;
  margin-inline: auto;
}
.about-story { margin-top: var(--space-10); }
.timeline {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 0;
}
.timeline::before {
  content: '';
  position: absolute;
  left: 92px;
  top: 18px;
  bottom: 18px;
  width: 1px;
  background: var(--color-border);
}
.timeline-item {
  display: grid;
  grid-template-columns: 68px 1fr;
  gap: var(--space-8);
  min-height: 132px;
  position: relative;
}
.timeline-year {
  color: var(--color-primary);
  font-family: var(--font-display);
  font-size: 0.875rem;
  font-weight: 800;
  text-align: right;
}
.timeline-item > div {
  position: relative;
  padding: 0 0 var(--space-8) var(--space-8);
}
.timeline-item > div::before {
  content: '';
  position: absolute;
  left: -7px;
  top: 4px;
  width: 13px;
  height: 13px;
  border: 3px solid var(--color-bg);
  border-radius: 50%;
  background: var(--color-primary);
  box-shadow: 0 0 0 1px var(--color-primary);
}
.timeline-item h3 {
  margin-bottom: var(--space-2);
  font-size: 1.15rem;
}
.timeline-item p {
  color: var(--color-text-muted);
  line-height: 1.7;
}
.mission-section {
  background: var(--color-bg-alt);
}
.mission-grid,
.infrastructure-grid,
.affiliation-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: var(--space-4);
}
.mission-card,
.infra-card,
.affiliation-card {
  min-height: 220px;
  padding: var(--space-6);
  border: 1.5px solid var(--color-border);
  border-radius: var(--radius-lg);
  background: var(--color-bg);
  transition: border-color var(--transition-fast), transform var(--transition-fast);
}
.mission-card:hover,
.infra-card:hover,
.affiliation-card:hover {
  border-color: var(--color-primary);
  transform: translateY(-3px);
}
.mission-number,
.affiliation-card > span {
  display: block;
  margin-bottom: var(--space-5);
  color: var(--color-primary);
  font-family: var(--font-display);
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.12em;
}
.mission-card h3,
.infra-card h3,
.affiliation-card h3 {
  margin-bottom: var(--space-3);
  font-size: 1.05rem;
}
.mission-card p,
.infra-card p,
.affiliation-card p {
  color: var(--color-text-muted);
  font-size: 0.875rem;
  line-height: 1.65;
}
.infrastructure-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}
.infra-featured {
  grid-row: span 2;
  min-height: 280px;
  background: var(--color-primary);
  color: #fff;
}
.infra-featured p { color: rgba(255,255,255,0.78); }
.infra-number {
  display: block;
  margin-bottom: var(--space-8);
  font-family: var(--font-display);
  font-size: clamp(3.5rem, 8vw, 6rem);
  font-weight: 800;
  line-height: 0.9;
}
.infra-label {
  display: block;
  margin-bottom: var(--space-5);
  color: var(--color-primary);
  font-size: 0.75rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}
.infra-card:not(.infra-featured) {
  min-height: 132px;
  grid-column: span 2;
}
.affiliation-section {
  background: var(--color-bg-alt);
}
.affiliation-lead {
  max-width: 720px;
  margin-top: calc(-1 * var(--space-4));
  margin-bottom: var(--space-8);
  color: var(--color-text-muted);
  line-height: 1.7;
}
.affiliation-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}
.affiliation-card { min-height: 190px; }
.location-grid {
  display: grid;
  grid-template-columns: 0.38fr 0.62fr;
  gap: var(--space-10);
  align-items: stretch;
}
.location-info address {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  margin: var(--space-6) 0;
  font-style: normal;
  color: var(--color-text-muted);
}
.location-info address strong {
  margin-bottom: var(--space-2);
  color: var(--color-text);
}
.map-block {
  min-height: 420px;
  overflow: hidden;
  border: 1.5px solid var(--color-border);
  border-radius: var(--radius-lg);
}
.map-block iframe { width: 100%; height: 100%; min-height: 420px; display: block; }

@media (max-width: 980px) {
  .mission-grid,
  .affiliation-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .infrastructure-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .infra-featured { grid-row: auto; }
  .infra-card:not(.infra-featured) { grid-column: span 1; }
  .location-grid { grid-template-columns: minmax(0, 1fr); }
  .location-info { max-width: 520px; }
}
@media (max-width: 600px) {
  .about-hero { padding-block: var(--space-10); }
  .about-section { padding-block: var(--space-10); }
  .mission-grid,
  .infrastructure-grid,
  .affiliation-grid { grid-template-columns: minmax(0, 1fr); }
  .infra-card:not(.infra-featured) { grid-column: auto; }
  .timeline::before { left: 9px; }
  .timeline-item {
    grid-template-columns: 1fr;
    gap: 0;
  }
  .timeline-year {
    margin-left: var(--space-8);
    text-align: left;
  }
  .timeline-item > div {
    margin-left: 9px;
    padding-left: var(--space-8);
  }
  .timeline-item > div::before { left: -7px; }
  .map-block { min-height: 320px; }
  .map-block iframe { min-height: 320px; }
}
</style>
