---
import ColorBar from '../ui/ColorBar.astro';
import { ui } from '../../i18n';
interface Props { lang?: 'en' | 'pt' | 'es'; }
const { lang = 'en' } = Astro.props;
const copy = ui[lang].hero;
---
<section class="hero">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-geo geo-1"></div>
    <div class="hero-geo geo-2"></div>
    <div class="hero-geo geo-3"></div>
    <div class="hero-geo geo-4"></div>
  </div>

  <div class="container hero-inner">
    <div class="hero-content">
      <span class="hero-eyebrow animate-fade-up">{copy.eyebrow}</span>
      <h1 class="hero-title animate-fade-up stagger-1">
        {copy.headline}
      </h1>
      <p class="hero-lead animate-fade-up stagger-2">
        {copy.summary}
      </p>
      <div class="hero-ctas animate-fade-up stagger-3">
        <a href={`/${lang}/projects/`} class="btn btn-primary">{copy.exploreProjects}</a>
        <a href={`/${lang}/research-areas/`} class="btn btn-outline">{copy.viewAreas}</a>
      </div>
    </div>

    <div class="hero-visual animate-fade-up stagger-2" aria-label={copy.areasAria}>
      <div class="visual-ring ring-outer"></div>
      <div class="visual-ring ring-inner"></div>
      <div class="visual-core">
        <span>NCA</span>
        <strong>UFMA</strong>
      </div>
      <span class="visual-node node-ai">AI</span>
      <span class="visual-node node-cv">CV</span>
      <span class="visual-node node-nlp">NLP</span>
      <span class="visual-node node-xr">XR</span>
    </div>
  </div>

  <ColorBar class="hero-bar" />
</section>

<style>
.hero {
  position: relative;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--color-bg);
}

.hero-bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
}
.hero-geo {
  position: absolute;
  border-radius: 2px;
  opacity: 0.06;
}
.geo-1 {
  width: 420px; height: 420px;
  background: var(--color-primary);
  top: -80px; right: -80px;
  transform: rotate(25deg);
  border-radius: var(--radius-xl);
}
.geo-2 {
  width: 280px; height: 280px;
  background: var(--color-secondary);
  bottom: 40px; right: 180px;
  transform: rotate(-15deg);
  border-radius: var(--radius-lg);
}
.geo-3 {
  width: 160px; height: 160px;
  background: var(--color-accent);
  top: 120px; right: 320px;
  transform: rotate(40deg);
  border-radius: var(--radius-md);
}
.geo-4 {
  width: 90px; height: 90px;
  background: var(--color-tagline);
  top: 60px; left: 40%;
  transform: rotate(12deg);
  border-radius: var(--radius-md);
}



.hero-content { max-width: 680px; position: relative; z-index: 2; }

.hero-eyebrow {
  display: inline-flex;
  margin-bottom: var(--space-5);
  padding: 0.35rem 0.75rem;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-full);
  color: var(--color-primary);
  background: rgba(255,255,255,0.75);
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.hero-title {
  font-family: var(--font-display);
  font-size: clamp(2.75rem, 5.8vw, 4.75rem);
  font-weight: 800;
  line-height: 1.05;
  letter-spacing: -0.03em;
  margin-bottom: var(--space-5);
  color: var(--color-text);
  max-width: 12ch;
}

.hero-tagline {
  font-size: clamp(1.125rem, 2vw, 1.5rem);
  line-height: 1.35;
  margin-bottom: var(--space-6);
  max-width: 58ch;
}

.hero-lead {
  font-size: clamp(1rem, 1.4vw, 1.125rem);
  color: var(--color-text);
  line-height: 1.7;
  margin-bottom: var(--space-7);
  max-width: 60ch;
}
.hero-lead strong {
  font-weight: 700;
  color: var(--color-text);
}
.hero-link {
  color: var(--color-primary);
  font-weight: 600;
  text-decoration: none;
  border-bottom: 1.5px solid transparent;
  transition: border-color var(--transition-fast);
}
.hero-link:hover {
  border-bottom-color: var(--color-primary);
}

.hero-ctas {
  display: flex;
  gap: var(--space-3);
  flex-wrap: wrap;
}

.hero-bar { margin-top: auto; }

@media (max-width: 600px) {
  .hero-ctas { gap: var(--space-2); }
  .btn { font-size: 0.875rem; padding: 0.5rem 1rem; }
}
.hero-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-12);
  min-height: 520px;
  padding-block: var(--space-12);
}

.hero-visual {
  position: relative;
  width: clamp(220px, 40vw, 360px);
  aspect-ratio: 1;
  flex: 0 0 auto;
  display: grid;
  place-items: center;
}
.visual-ring,
.visual-core,
.visual-node { position: absolute; }
.visual-ring {
  border: 1px solid var(--color-border);
  border-radius: 50%;
}
.ring-outer { inset: 0; }
.ring-inner { inset: 15%; border-color: rgba(35,70,229,0.24); }
.visual-core {
  width: 31%;
  height: 31%;
  min-width: 72px;
  min-height: 72px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  box-shadow: 0 18px 50px rgba(35,70,229,0.24);
  font-family: var(--font-display);
}
.visual-core span { font-size: clamp(0.85rem, 3.2vw, 1.15rem); font-weight: 800; }
.visual-core strong { font-size: 0.75rem; letter-spacing: 0.12em; }
.visual-node {
  width: 14.5%;
  height: 14.5%;
  min-width: 40px;
  min-height: 40px;
  display: grid;
  place-items: center;
  border: 1px solid var(--color-border);
  border-radius: 50%;
  background: #fff;
  color: var(--color-primary);
  box-shadow: var(--shadow-md);
  font-size: 0.75rem;
  font-weight: 800;
}
.node-ai { top: 5%; left: 43%; }
.node-cv { right: 5%; top: 43%; }
.node-nlp { bottom: 5%; left: 43%; }
.node-xr { left: 5%; top: 43%; }

@media (max-width: 980px) {
  .hero-inner { min-height: auto; }
}
@media (max-width: 900px) {
  .hero-inner { flex-direction: column; align-items: flex-start; padding-block: var(--space-10); }
  .hero-visual { align-self: center; width: clamp(200px, 55vw, 280px); }
}
</style>
